<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key>
    <string>Loaf Chat</string>
    <key>CFBundleDisplayName</key>
    <string>Loaf Chat</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>

    <!--
      Proven configuration (docs/superpowers/specs/2026-09-20-ios-client-design.md,
      "Decision: bundled origin on a fixed loopback port" and "Step 0: the
      spike"): 127.0.0.1 only, no ATS exception of any kind.
      NSAllowsArbitraryLoads / NSAllowsLocalNetworking were both tested in
      the spike and are unnecessary -- do not add them back. Loopback is
      exempt from ATS on its own.
    -->
    <!--
      Deliberately just the app's own origin. SSO login used to need the
      homeserver and identity provider bound here, but it now runs in an
      ASWebAuthenticationSession instead (see SSOFlow.swift), so the webview
      never navigates off-origin at the top level.

      Keeping them bound would be worse than useless: if the SSO
      interception in WebViewController ever stopped matching, the
      navigation would silently succeed in-app -- the exact UX the system
      sheet exists to replace -- instead of failing loudly with WKError 13.
    -->
    <key>WKAppBoundDomains</key>
    <array>
        <string>127.0.0.1</string>
    </array>

    <!--
      The ASWebAuthenticationSession callback scheme. See SSOFlow.callbackScheme.
    -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>moe.loaf.chat.ios.sso</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>moe.loaf.chat.ios</string>
            </array>
        </dict>
    </array>

    <!-- Calls (see "Calls" in the design doc): getUserMedia needs both. -->
    <!--
      Export compliance: the app's only cryptography is the OS's own TLS, which
      is exempt. Without this key TestFlight stops every build to ask.
    -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>NSCameraUsageDescription</key>
    <string>Loaf Chat uses the camera for video calls.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Loaf Chat uses the microphone for voice and video calls.</string>

    <!--
      v1 keeps a call's audio alive in the background (CallKit ongoing-call
      support, not ringing -- see "Why ringing is deferred"). No push
      background mode: APNs is out of scope, blocked on Apple Developer
      Program enrollment.
    -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>
</dict>
</plist>
