<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>LoafChat</string>
    <key>CFBundleIdentifier</key>
    <string>moe.loaf.chat.ios</string>
    <key>CFBundleName</key>
    <string>Loaf Chat</string>
    <key>CFBundleDisplayName</key>
    <string>Loaf Chat</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>MinimumOSVersion</key>
    <string>18.0</string>
    <key>DTPlatformName</key>
    <string>iphonesimulator</string>

    <!--
      Proven configuration (docs/superpowers/specs/2026-09-20-ios-client-design.md,
      "Decision: bundled origin on a fixed loopback port" and "Step 0: the
      spike"): 127.0.0.1 only, no ATS exception of any kind.
      NSAllowsArbitraryLoads / NSAllowsLocalNetworking were both tested in
      the spike and are unnecessary -- do not add them back. Loopback is
      exempt from ATS on its own.
    -->
    <key>WKAppBoundDomains</key>
    <array>
        <string>127.0.0.1</string>
    </array>

    <!-- Calls (see "Calls" in the design doc): getUserMedia needs both. -->
    <key>NSCameraUsageDescription</key>
    <string>Loaf Chat uses the camera for video calls.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Loaf Chat uses the microphone for voice and video calls.</string>

    <!--
      v1 keeps a call's audio alive in the background (CallKit ongoing-call
      support, not ringing -- see "Why ringing is deferred"). No push
      background mode: APNs is out of scope, blocked on Apple Developer
      Program enrollment.
    -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>
</dict>
</plist>
