<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the signed, notarized macOS build.

  electron-builder REPLACES its built-in template with this file rather than
  merging the two (see getEntitlements in app-builder-lib's MacTargetHelper),
  so the three Electron runtime entitlements below are restated here. Dropping
  any of them produces an app that is signed and notarized and still crashes on
  launch. Helper processes keep the built-in template: electron-builder only
  reaches for entitlements.mac.inherit.plist, which we deliberately do not ship.

  Hardened runtime is on by default for non-MAS mac builds and is required for
  notarization, so every capability the app uses has to be declared.
-->
<plist version="1.0">
  <dict>
    <!-- V8 compiles JavaScript at runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Electron internals map executable pages the above does not cover. -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Electron loads frameworks signed with a different team ID. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!--
      Voice and video calls. Under the hardened runtime these are required in
      addition to the NSCameraUsageDescription and NSMicrophoneUsageDescription
      strings in the mac.extendInfo block: the usage strings only supply the
      text of the TCC prompt, while these entitlements are what permit the
      process to open the devices at all. Without them getUserMedia fails and
      the app looks like it simply cannot hear you.

      Screen sharing needs no entitlement — macOS gates it through the Screen
      Recording TCC permission, granted in System Settings on first capture.
    -->
    <key>com.apple.security.device.camera</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
  </dict>
</plist>
